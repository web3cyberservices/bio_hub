
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Stores core information about a user, including biometrics and habits.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string", "description": "URL of the professional profile photo." },
        "birthDate": { "type": "string", "format": "date", "description": "User's date of birth." },
        "gender": { "type": "string" },
        "age": { "type": "number" },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "activityLevel": { "type": "string" },
        "healthGoal": { "type": "string" },
        "profileType": { "type": "string", "enum": ["user", "specialist"] },
        "specialization": { "type": "string" },
        "bio": { "type": "string" },
        "instagramUrl": { "type": "string", "description": "Link to specialist's Instagram profile." },
        "sharedWith": { "type": "array", "items": { "type": "string" }, "description": "List of specialist UIDs who have access to this user's data." },
        "rating": { "type": "number" },
        "followers": { "type": "array", "items": { "type": "string" }, "description": "List of user UIDs who follow this specialist." },
        "favoriteFoods": { "type": "string" },
        "dislikedFoods": { "type": "string" },
        "medications": { "type": "string", "description": "Medications, tablets, or supplements user is currently taking." },
        "dateJoined": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firstName", "profileType"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["physical", "mental"] },
        "duration": { "type": "number", "description": "Minutes" },
        "calories": { "type": "number" },
        "intensity": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "WorkoutPlan": {
      "title": "WorkoutPlan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "exercises": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "sets": { "type": "number" },
              "reps": { "type": "string" },
              "weight": { "type": "string" }
            }
          }
        },
        "createdBy": { "type": "string" },
        "status": { "type": "string", "enum": ["planned", "completed"] }
      }
    },
    "PersonalMeal": {
      "title": "PersonalMeal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "name": { "type": "string" },
        "time": { "type": "string" },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "fat": { "type": "number" },
        "carbs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "name", "time"]
    }
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}/activities/{activityId}", "definition": { "entityName": "ActivityLog" } },
      { "path": "/users/{userId}/workouts/{workoutId}", "definition": { "entityName": "WorkoutPlan" } }
    ]
  }
}
