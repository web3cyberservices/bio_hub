
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Профиль пользователя с биометрическими данными и целями",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Уникальный ID пользователя из Firebase Auth" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["мужской", "женский"] },
        "healthGoal": { "type": "string", "enum": ["снизить массу тела", "поддержать текущее состояние", "набор массы"] },
        "activityLevel": { "type": "string", "enum": ["малоактивный", "среднеактивный", "средний", "активный", "перенагрузка"] },
        "smoking": { "type": "string", "enum": ["да", "нет"] },
        "alcohol": { "type": "string", "enum": ["не употребляю", "редко", "умеренно", "часто"] }
      },
      "required": ["uid", "email"]
    },
    "DailyRecommendation": {
      "title": "DailyRecommendation",
      "description": "Сохраненная рекомендация ИИ на конкретную дату",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "data": { "type": "object", "description": "Результат выполнения generatePersonalizedRecommendations" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Данные профиля пользователя"
    },
    "/users/{userId}/recommendations/{date}": {
      "schema": "DailyRecommendation",
      "description": "История ежедневных рекомендаций и планов питания"
    }
  }
}
