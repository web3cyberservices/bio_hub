
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Stores core information about a user, including biometrics and habits.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string", "description": "URL of the professional profile photo." },
        "birthDate": { "type": "string", "format": "date", "description": "User's date of birth." },
        "gender": { "type": "string" },
        "age": { "type": "number" },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "activityLevel": { "type": "string" },
        "healthGoal": { "type": "string" },
        "profileType": { "type": "string", "enum": ["user", "specialist"] },
        "specialization": { "type": "string" },
        "bio": { "type": "string" },
        "rating": { "type": "number" },
        "favoriteFoods": { "type": "string" },
        "dislikedFoods": { "type": "string" },
        "dateJoined": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firstName", "profileType"]
    },
    "SpecialistPost": {
      "title": "SpecialistPost",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "likes": { "type": "number" },
        "likedBy": { "type": "array", "items": { "type": "string" }, "description": "List of user UIDs who liked the post." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "content", "createdAt"]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "participantDetails": { "type": "object" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participants"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderId", "text", "createdAt"]
    },
    "DailyLog": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "DailyLog",
      "type": "object",
      "description": "Daily biometric and lifestyle metrics tracked by the user.",
      "properties": {
        "date": { "type": "string" },
        "water": { "type": "number" },
        "weight": { "type": "number" },
        "steps": { "type": "number" },
        "mood": { "type": "string" },
        "energy": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date"]
    },
    "DietaryLog": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "DietaryLog",
      "type": "object",
      "description": "Records of specific meals with AI analysis.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "logDate": { "type": "string", "format": "date-time" },
        "mealName": { "type": "string" },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "fat": { "type": "number" },
        "carbs": { "type": "number" },
        "analysis": { "type": "string" }
      },
      "required": ["id", "userId", "logDate", "mealName"]
    },
    "Recommendation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Recommendation",
      "type": "object",
      "description": "AI-generated personalized health recommendations.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "data": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "date", "data"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" }
        }
      },
      {
        "path": "/posts/{postId}",
        "definition": {
          "entityName": "SpecialistPost",
          "schema": { "$ref": "#/backend/entities/SpecialistPost" }
        }
      },
      {
        "path": "/chats/{chatId}",
        "definition": {
          "entityName": "ChatRoom",
          "schema": { "$ref": "#/backend/entities/ChatRoom" }
        }
      },
      {
        "path": "/chats/{chatId}/messages/{messageId}",
        "definition": {
          "entityName": "ChatMessage",
          "schema": { "$ref": "#/backend/entities/ChatMessage" }
        }
      },
      {
        "path": "/users/{userId}/dailyLogs/{date}",
        "definition": {
          "entityName": "DailyLog",
          "schema": { "$ref": "#/backend/entities/DailyLog" }
        }
      },
      {
        "path": "/users/{userId}/dietaryLogs/{dietaryLogId}",
        "definition": {
          "entityName": "DietaryLog",
          "schema": { "$ref": "#/backend/entities/DietaryLog" }
        }
      },
      {
        "path": "/users/{userId}/recommendations/{date}",
        "definition": {
          "entityName": "Recommendation",
          "schema": { "$ref": "#/backend/entities/Recommendation" }
        }
      }
    ]
  }
}
