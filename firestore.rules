rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * ТЕСТОВЫЙ РЕЖИМ (БЕЗ ОГРАНИЧЕНИЙ)
     * Разрешаем любые операции чтения и записи для абсолютно всех документов.
     * Это правило перекрывает любые другие и гарантирует доступ в процессе разработки.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}