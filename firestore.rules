rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ
     * Обеспечивают полный доступ владельцам данных и открытость для тестового режима.
     */

    // Проверка авторизации
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Проверка владения документом или принадлежности к гостевой песочнице
    function isOwner(userId) {
      return (isAuthenticated() && request.auth.uid == userId) || userId == 'public-user';
    }

    // --- Коллекция пользователей и их данные ---
    match /users/{userId} {
      // Доступ к самому документу профиля
      allow read, write: if isOwner(userId);
      
      // Публичный доступ к базовой информации (нужно для отображения специалистов в ленте)
      // Разрешаем get и list для всех, чтобы поиск и отображение в ленте работали корректно
      allow get, list: if true;

      // РЕКУРСИВНОЕ ПРАВИЛО ДЛЯ ВСЕХ ПОДКОЛЛЕКЦИЙ
      // Это критически важно для работы useCollection (операция list) 
      // в коллекциях personalMeals, dailyLogs, dietaryLogs и т.д.
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }

      // Публичные отзывы о специалистах
      match /reviews/{reviewId} { 
        allow read: if true; 
        allow create: if isAuthenticated() || userId == 'public-user'; 
      }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read: if true; 
      allow create: if isAuthenticated() || isOwner('public-user');
      allow update, delete: if isOwner(resource.data.authorId) || isOwner('public-user');
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      // В прототипе разрешаем доступ для упрощения тестирования
      allow read, write: if true; 
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}