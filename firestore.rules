
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - SECURITY RULES
     */

    // --- Базовые проверки ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Правила для коллекций ---

    // Профили пользователей
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Запрещаем массовое перечисление всех пользователей
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Ежедневные логи (шаги, вода и т.д.)
      match /dailyLogs/{dailyLogId} {
        allow read, write: if isOwner(userId);
      }

      // Логи питания
      match /dietaryLogs/{dietaryLogId} {
        allow read, write: if isOwner(userId);
      }

      // Рекомендации ИИ
      match /recommendations/{recommendationId} {
        allow read, write: if isOwner(userId);
      }
      
      // Результаты анализов
      match /labResults/{labId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Публикации специалистов в ленте
    match /posts/{postId} {
      allow read: if isSignedIn();
      // Создавать посты может только специалист (проверяем тип в документе пользователя)
      allow create: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileType == 'specialist';
      allow update: if isSignedIn(); // Для лайков
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Система чатов
    match /chats/{chatId} {
      // Доступ к чату имеют только его участники
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      
      // Создание чата разрешено, если текущий пользователь является одним из участников
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      // Сообщения внутри чата
      match /messages/{messageId} {
        // Читать и писать сообщения могут только участники родительского чата
        allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
