
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - SECURITY RULES
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSpecialist() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileType == 'specialist';
    }

    // --- Правила для коллекций ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; 
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      match /dailyLogs/{dailyLogId} {
        allow read, write: if isOwner(userId);
      }

      match /dietaryLogs/{dietaryLogId} {
        allow read, write: if isOwner(userId);
      }

      match /recommendations/{recommendationId} {
        allow read, write: if isOwner(userId);
      }
      
      match /labResults/{labId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); 
      allow update: if isSignedIn(); 
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Система чатов
    match /chats/{chatId} {
      // Разрешаем чтение (get и list) если пользователь в списке участников
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      
      // Разрешаем создание, если текущий пользователь включен в список участников
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
      
      // Разрешаем обновление метаданных чата участникам
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        // Доступ к сообщениям через проверку участников в родительском документе чата
        allow read, create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
      }
    }
  }
}
