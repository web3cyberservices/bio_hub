rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ФИНАЛЬНЫЕ ПРАВИЛА БЕЗОПАСНОСТИ
     * Обеспечиваем гарантированный доступ для всех авторизованных пользователей.
     */

    // --- Профили пользователей ---
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /dailyLogs/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /dietaryLogs/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /recommendations/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /labResults/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      // Разрешаем чтение и создание чатов всем авторизованным
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, create: if request.auth != null;
        // Редактировать и удалять может только автор сообщения
        allow update, delete: if request.auth != null && resource.data.senderId == request.auth.uid;
      }
    }
  }
}