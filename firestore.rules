rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * ГЛОБАЛЬНЫЙ ДОСТУП (DEBUG MODE)
     * Мы разрешаем абсолютно любые операции чтения и записи для всех документов.
     * Это гарантированно устраняет ошибку "Missing or insufficient permissions" для метода list.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}