rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ОТКРЫТЫЕ ПРАВИЛА ДОСТУПА
     * Мы открываем доступ к данным пользователей для устранения ошибок Permission Denied,
     * как запрошено пользователем.
     */
    
    // 1. ПОЛЬЗОВАТЕЛИ И ИХ ДАННЫЕ (ОТКРЫТО)
    match /users/{userId} {
      // Разрешаем всё для всех уровней вложенности
      allow read, write: if true;
      
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // 2. BIO-ЛЕНТА (ПОСТЫ)
    match /posts/{postId} {
      allow read, write: if true;
    }

    // 3. СИСТЕМА ЧАТОВ
    match /chats/{chatId} {
      allow read, write: if true; 
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    // 4. ПУБЛИЧНЫЙ ДОСТУП КО ВСЕМУ ОСТАЛЬНОМУ
    match /{document=**} {
      allow read, write: if true;
    }
  }
}