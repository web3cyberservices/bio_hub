rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ 20.0
     * Полный доступ для владельцев и расширенная песочница для гостей.
     */

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return (isAuthenticated() && request.auth.uid == userId) || userId == 'public-user';
    }

    // --- Профили пользователей и вложенные данные ---
    match /users/{userId} {
      // Базовый доступ к документу профиля
      allow read, write: if isOwner(userId);
      // Разрешаем всем видеть публичную инфу специалистов
      allow get: if resource != null && resource.data.profileType == 'specialist';
      // Для поиска специалистов в ленте
      allow list: if true;

      // Рекурсивный доступ ко всем вложенным коллекциям (meals, logs, recommendations и т.д.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }

      // Отзывы о специалистах доступны всем на чтение
      match /reviews/{reviewId} { 
        allow read: if true;
        allow create: if isAuthenticated() || isOwner('public-user');
      }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read: if true; 
      allow create: if isAuthenticated() || isOwner('public-user');
      allow update, delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isOwner('public-user');
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      allow read, write: if (isAuthenticated() && (request.auth.uid in resource.data.participants)) || isOwner('public-user');
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() || isOwner('public-user');
      }
    }
  }
}