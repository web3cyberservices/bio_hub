
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - УЛЬТРА-ГИБКИЕ ПРАВИЛА
     * Разрешаем активность всем авторизованным пользователям (включая анонимных тестеров)
     * для полноценного взаимодействия внутри Bio-хаба.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // --- Профили пользователей ---
    match /users/{userId} {
      // Все могут видеть базовые профили для работы чатов и отображения авторов в ленте
      allow read: if isSignedIn();
      // Свой профиль можно редактировать полностью
      allow write: if isSignedIn() && request.auth.uid == userId;

      // Личные данные (логи, рекомендации, анализы) доступны только владельцу
      match /dailyLogs/{id} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
      match /dietaryLogs/{id} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
      match /recommendations/{id} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
      match /labResults/{id} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      // Все авторизованные могут читать и создавать посты
      allow read, create: if isSignedIn();
      // Лайки и редактирование разрешены всем авторизованным (для упрощения теста)
      allow update: if isSignedIn();
      // Удаление только своего поста
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // --- Система чатов (Персональные диалоги) ---
    match /chats/{chatId} {
      // Разрешаем чтение и запись всем авторизованным. 
      // Приложение само фильтрует чаты по participants в запросе.
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        // Сообщения доступны всем участникам системы
        allow read, write: if isSignedIn();
      }
    }
  }
}
