
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - SECURITY RULES
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSpecialist() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileType == 'specialist';
    }

    // --- Правила для коллекций ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; 
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      match /dailyLogs/{dailyLogId} {
        allow read, write: if isOwner(userId);
      }

      match /dietaryLogs/{dietaryLogId} {
        allow read, write: if isOwner(userId);
      }

      match /recommendations/{recommendationId} {
        allow read, write: if isOwner(userId);
      }
      
      match /labResults/{labId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSpecialist();
      allow update: if isSignedIn(); 
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Система чатов
    match /chats/{chatId} {
      // Использование allow read для поддержки get и list (запросы с фильтрами)
      allow read, update: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);

      match /messages/{messageId} {
        // Проверка через родительский чат
        allow read, create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
      }
    }
  }
}
