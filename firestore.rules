rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ (ULTIMATE FIX)
     * Эти правила гарантируют полный доступ владельца к своим данным, включая операции LIST.
     */

    // 1. ГЛАВНОЕ ПРАВИЛО ВЛАДЕЛЬЦА
    // Использование {anyPath=**} на уровне пользователя гарантирует, что 
    // ВСЕ документы и ВСЕ коллекции внутри пути /users/{userId}/ будут доступны владельцу.
    // Это исправляет ошибку 'method: list' для подколлекций типа personalMeals.
    match /users/{userId}/{anyPath=**} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || userId == 'public-user';
    }

    // 2. ПУБЛИЧНЫЕ ПРОФИЛИ
    // Разрешаем всем видеть базовую информацию пользователей (нужно для ленты специалистов).
    // Это правило дополняет предыдущее, открывая только чтение самого документа профиля.
    match /users/{userId} {
      allow read: if true;
    }

    // 3. ПУБЛИЧНЫЕ ОТЗЫВЫ
    // Отзывы должны быть видны всем, а создавать их могут авторизованные пользователи.
    match /users/{userId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null || userId == 'public-user';
    }

    // 4. BIO-ЛЕНТА (ПОСТЫ)
    match /posts/{postId} {
      allow read: if true; 
      allow create: if request.auth != null || (request.auth == null && request.resource.data.authorId == 'public-user');
      allow update, delete: if (request.auth != null && request.auth.uid == resource.data.authorId) || resource.data.authorId == 'public-user';
    }

    // 5. СИСТЕМА ЧАТОВ
    // В прототипе разрешаем доступ для упрощения тестирования.
    match /chats/{chatId} {
      allow read, write: if true; 
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}