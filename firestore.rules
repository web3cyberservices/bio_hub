rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ФИНАЛЬНЫЕ ПРАВИЛА БЕЗОПАСНОСТИ
     * Обеспечиваем гарантированный доступ для всех авторизованных пользователей,
     * включая анонимные (тестовые) сессии.
     */

    // --- Профили пользователей ---
    match /users/{userId} {
      // Все авторизованные могут видеть базовые профили (для чатов и ленты)
      allow read: if request.auth != null;
      // Свой профиль можно редактировать полностью
      allow write: if request.auth != null && request.auth.uid == userId;

      // Личные данные (логи, рекомендации, анализы) доступны только владельцу
      match /dailyLogs/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /dietaryLogs/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /recommendations/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /labResults/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // --- Система чатов (Персональные диалоги) ---
    // Усиленные правила для 'list' и 'get' для устранения Permission Error
    match /chats/{chatId} {
      allow get, list, create, update: if request.auth != null;
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list, create: if request.auth != null;
      }
    }
  }
}
