rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ (ULTIMATE FIX)
     * Мы используем иерархическую структуру для гарантированного доступа к под-коллекциям.
     */
    
    // 1. БАЗОВЫЕ ПРАВИЛА ДЛЯ ПОЛЬЗОВАТЕЛЕЙ
    match /users/{userId} {
      // Доступ владельца ко всему дереву данных (включая личный документ и ВСЕ под-коллекции)
      // Правило {allPaths=**} внутри блока пользователя — самый надежный способ разрешить 'list'
      allow read, write: if (request.auth != null && request.auth.uid == userId) || userId == 'public-user';
      
      match /{allPaths=**} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || userId == 'public-user';
      }
    }

    // 2. ПУБЛИЧНЫЙ ДОСТУП К ПРОФИЛЯМ
    // Разрешаем всем видеть основные данные профиля (нужно для специалистов в ленте)
    match /users/{userId} {
      allow read: if true;
    }

    // 3. ПУБЛИЧНЫЕ ОТЗЫВЫ
    match /users/{userId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null || userId == 'public-user';
    }

    // 4. BIO-ЛЕНТА (ПОСТЫ)
    match /posts/{postId} {
      allow read: if true; 
      allow create: if request.auth != null || (request.auth == null && request.resource.data.authorId == 'public-user');
      allow update, delete: if (request.auth != null && request.auth.uid == resource.data.authorId) || resource.data.authorId == 'public-user';
    }

    // 5. СИСТЕМА ЧАТОВ
    match /chats/{chatId} {
      allow read, write: if true; 
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}