rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * ПОЛНЫЙ ПУБЛИЧНЫЙ ДОСТУП
     * Мы разрешаем чтение и запись для ВСЕХ документов на любом уровне вложенности.
     * Это гарантированно убирает ошибку "Missing or insufficient permissions".
     */
    match /{document=**} {
      allow read, write: if true;
    }
  }
}