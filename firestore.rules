rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ 18.0
     * Полный доступ для владельцев и открытая гостевая песочница.
     */

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return (isAuthenticated() && request.auth.uid == userId) || userId == 'public-user';
    }

    // --- Профили пользователей и вложенные данные ---
    match /users/{userId} {
      // Базовый доступ к документу профиля
      allow get: if isOwner(userId) || (resource != null && resource.data.profileType == 'specialist');
      allow list: if true; // Для поиска специалистов
      allow write: if isOwner(userId);

      // Явный доступ ко всем личным подколлекциям (для list и get операций)
      match /personalMeals/{mealId} { allow read, write: if isOwner(userId); }
      match /dailyLogs/{logId} { allow read, write: if isOwner(userId); }
      match /dietaryLogs/{logId} { allow read, write: if isOwner(userId); }
      match /recommendations/{logId} { allow read, write: if isOwner(userId); }
      match /labResults/{logId} { allow read, write: if isOwner(userId); }
      match /reviews/{reviewId} { 
        allow read: if true;
        allow write: if isAuthenticated() || isOwner('public-user');
      }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read: if true; 
      allow create: if isAuthenticated() || isOwner('public-user');
      allow update, delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isOwner('public-user');
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      allow read, write: if (isAuthenticated() && (request.auth.uid in resource.data.participants)) || isOwner('public-user');
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() || isOwner('public-user');
      }
    }
  }
}