
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ 16.0
     * Оптимизировано для мгновенного доступа и работы в тестовом режиме.
     */

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return (isAuthenticated() && request.auth.uid == userId) || userId == 'public-user';
    }

    // --- Профили пользователей ---
    match /users/{userId} {
      // Разрешаем просмотр профиля если владелец ИЛИ если это специалист
      allow get: if isOwner(userId) || (resource != null && resource.data.profileType == 'specialist') || userId == 'public-user';
      
      // Разрешаем список пользователей всем (для поиска экспертов)
      allow list: if true;

      // Запись владельцу или в тестовый профиль
      allow write: if isOwner(userId);

      // Глубокий доступ ко всем вложенным данным (питание, логи, рекомендации и т.д.)
      // Это правило покрывает операции get, list, create, update, delete
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || userId == 'public-user';
      }
      
      // Специальное правило для отзывов (публичное чтение, авторизованная запись)
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isAuthenticated() || isOwner('public-user');
      }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read: if true; 
      allow create: if isAuthenticated() || isOwner('public-user');
      allow update, delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isOwner('public-user');
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      allow read, write: if (isAuthenticated() && (request.auth.uid in resource.data.participants)) || isOwner('public-user');
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() || isOwner('public-user');
      }
    }
  }
}
