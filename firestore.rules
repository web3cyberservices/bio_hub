rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ (FINAL RECURSIVE FIX)
     * Мы разрешаем полный доступ владельцу ко всем своим данным и под-коллекциям.
     */
    
    // 1. ПРАВИЛО ВЛАДЕНИЯ (РЕКУРСИВНОЕ)
    // Конструкция {document=**} охватывает как сам документ пользователя, так и все его вложенные коллекции (personalMeals, dailyLogs и др.).
    // Это гарантирует работу метода 'list' для любого уровня вложенности.
    match /users/{userId}/{document=**} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || userId == 'public-user';
    }

    // 2. ПУБЛИЧНЫЕ ПРОФИЛИ (ТОЛЬКО ЧТЕНИЕ)
    // Разрешаем просмотр основного документа пользователя, если он является специалистом.
    match /users/{userId} {
      allow read: if true;
    }

    // 3. ПУБЛИЧНЫЕ ОТЗЫВЫ
    // Отзывы к специалистам должны быть видны всем.
    match /users/{userId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null || userId == 'public-user';
    }

    // 4. BIO-ЛЕНТА (ПОСТЫ)
    match /posts/{postId} {
      allow read: if true; 
      allow create: if request.auth != null || (request.auth == null && request.resource.data.authorId == 'public-user');
      allow update, delete: if (request.auth != null && request.auth.uid == resource.data.authorId) || resource.data.authorId == 'public-user';
    }

    // 5. СИСТЕМА ЧАТОВ
    match /chats/{chatId} {
      allow read, write: if true; 
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}