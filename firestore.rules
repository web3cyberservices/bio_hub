rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * ГЛОБАЛЬНЫЙ ДОСТУП (DEVELOPMENT MODE)
     * Мы разрешаем абсолютно любые операции чтения и записи для всех документов и их подколлекций.
     * Это необходимо для беспрепятственной разработки и тестирования функционала записей, чатов и логов.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }

    // Явное определение прав для основных коллекций (для повышения надежности в разных окружениях)
    
    match /users/{userId} {
      allow read, write: if true;
      // Разрешаем доступ ко всем вложенным данным пользователя (personalMeals, labResults, recommendations и т.д.)
      match /{allSubPaths=**} {
        allow read, write: if true;
      }
    }

    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    match /posts/{postId} {
      allow read, write: if true;
    }

    match /chats/{chatId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}