
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ 9.0
     * Открытый доступ для тестового режима и полная защита личных данных.
     */

    // Вспомогательные функции
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Профили пользователей и личные данные ---
    match /users/{userId} {
      // Разрешаем чтение и запись если это владелец ИЛИ если это публичный тестовый профиль
      allow read, write: if isOwner(userId) || userId == 'public-user';

      // Глубокий доступ ко всем вложенным коллекциям (планы, логи, анализы)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || userId == 'public-user';
      }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read, list: if true; // Чтение ленты доступно всем
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      allow read, get, list: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, list: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
