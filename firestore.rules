rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ 22.0
     * Полный доступ для владельцев и расширенная песочница для гостей.
     * Рекурсивные правила устраняют ошибки доступа к спискам (list) в подколлекциях.
     */

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return (isAuthenticated() && request.auth.uid == userId) || userId == 'public-user';
    }

    // --- Профили пользователей и вложенные данные ---
    match /users/{userId} {
      // Владелец (или любой гость для public-user) имеет полный доступ к своему профилю
      allow read, write: if isOwner(userId);
      
      // РЕКУРСИВНОЕ ПРАВИЛО: Разрешает все операции (включая list) во всех подколлекциях пользователя
      // Это исправляет ошибку доступа к /personalMeals, /dailyLogs, /dietaryLogs и т.д.
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }

      // Публичный доступ к базовой информации (нужно для отображения специалистов в ленте)
      allow get, list: if true;

      // Публичные отзывы (читать могут все, создавать — авторизованные или гости)
      match /reviews/{reviewId} { 
        allow read: if true; 
        allow create: if isAuthenticated() || isOwner('public-user'); 
      }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read: if true; 
      allow create: if isAuthenticated() || isOwner('public-user');
      allow update, delete: if isOwner(resource.data.authorId) || isOwner('public-user');
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      // В прототипе разрешаем доступ для упрощения тестирования чатов
      allow read, write: if true; 
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}