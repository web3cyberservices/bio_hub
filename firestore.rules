rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ (ULTIMATE RECURSIVE FIX)
     * Это правило гарантирует полный доступ владельца ко всему дереву данных внутри /users/{userId}/,
     * включая выполнение операции LIST для любых подколлекций (например, personalMeals).
     */
    
    // 1. ГЛАВНОЕ РЕКУРСИВНОЕ ПРАВИЛО ВЛАДЕЛЬЦА
    // Используем синтаксис {document=**} для покрытия всех документов и подколлекций.
    // Разрешаем доступ если пользователь авторизован и UID совпадает, либо это тестовый профиль.
    match /users/{userId}/{document=**} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || userId == 'public-user';
    }

    // 2. ПУБЛИЧНЫЕ ПРОФИЛИ
    // Разрешаем всем чтение основного документа пользователя (для отображения в ленте).
    match /users/{userId} {
      allow read: if true;
    }

    // 3. ПУБЛИЧНЫЕ ОТЗЫВЫ
    // Отзывы должны быть видны всем.
    match /users/{userId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null || userId == 'public-user';
    }

    // 4. BIO-ЛЕНТА (ПОСТЫ)
    match /posts/{postId} {
      allow read: if true; 
      allow create: if request.auth != null || (request.auth == null && request.resource.data.authorId == 'public-user');
      allow update, delete: if (request.auth != null && request.auth.uid == resource.data.authorId) || resource.data.authorId == 'public-user';
    }

    // 5. СИСТЕМА ЧАТОВ
    match /chats/{chatId} {
      allow read, write: if true; 
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}