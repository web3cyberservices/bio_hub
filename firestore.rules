rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ (FINAL FIX)
     * Обеспечивают полный доступ владельцам данных и открытость для тестового режима.
     */

    // --- Коллекция пользователей и их иерархия ---
    match /users/{userId} {
      
      // Правило 1: Владелец (или гость в тестовом режиме) имеет ПОЛНЫЙ доступ ко всему в своей ветке
      // Это правило применяется рекурсивно ко всем подколлекциям (personalMeals, dailyLogs и т.д.)
      // Именно это исправляет ошибку доступа при вызове useCollection (метод list)
      match /{allData=**} {
        allow read, write: if (request.auth != null && request.auth.uid == userId) || userId == 'public-user';
      }

      // Правило 2: Доступ к самому документу профиля
      // Разрешаем чтение всем (нужно для отображения специалистов в ленте)
      // Запись только владельцу
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || userId == 'public-user';

      // Публичные отзывы о специалистах
      match /reviews/{reviewId} { 
        allow read: if true; 
        allow create: if request.auth != null || userId == 'public-user'; 
      }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read: if true; 
      allow create: if request.auth != null || (request.auth == null && request.resource.data.authorId == 'public-user');
      allow update, delete: if (request.auth != null && request.auth.uid == resource.data.authorId) || resource.data.authorId == 'public-user';
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      // В прототипе разрешаем доступ для упрощения тестирования
      allow read, write: if true; 
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}