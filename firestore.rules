
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - SECURITY RULES
     * Разрешаем активность всем авторизованным пользователям (включая анонимных тестеров)
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Пользователи ---
    match /users/{userId} {
      // Все могут видеть базовые профили для чатов и ленты
      allow get, list: if isSignedIn();
      // Свой профиль можно редактировать
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      match /dailyLogs/{id} { allow read, write: if isOwner(userId); }
      match /dietaryLogs/{id} { allow read, write: if isOwner(userId); }
      match /recommendations/{id} { allow read, write: if isOwner(userId); }
      match /labResults/{id} { allow read, write: if isOwner(userId); }
    }

    // --- Посты в ленте ---
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn(); 
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid);
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      // Разрешаем чтение (get и list) только участникам
      // Важно: list требует, чтобы запрос содержал фильтр по participants
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      
      // Создавать чат может любой вошедший
      allow create: if isSignedIn();
      
      // Обновлять (lastMessage и т.д.) могут участники
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        // Разрешаем всем вошедшим читать и писать сообщения в чатах
        allow read, write: if isSignedIn();
      }
    }
  }
}
