rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * ГЛОБАЛЬНЫЙ ДОСТУП (DEVELOPMENT MODE)
     * Разрешаем абсолютно любые операции чтения и записи для всех документов и их подколлекций.
     * Это необходимо для беспрепятственной разработки и тестирования функционала записей, чатов и логов.
     */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}