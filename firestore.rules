rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ 21.0
     * Полный доступ для владельцев и расширенная песочница для гостей.
     */

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return (isAuthenticated() && request.auth.uid == userId) || userId == 'public-user';
    }

    // --- Профили пользователей и вложенные данные ---
    match /users/{userId} {
      // Базовый доступ к документу профиля
      allow read, write: if isOwner(userId);
      // Разрешаем всем видеть публичную инфу специалистов
      allow get: if true; 
      // Для поиска специалистов в ленте
      allow list: if true;

      // Явные правила для подколлекций (устраняет ошибки list)
      match /personalMeals/{id} { allow read, write: if isOwner(userId); }
      match /dailyLogs/{id} { allow read, write: if isOwner(userId); }
      match /dietaryLogs/{id} { allow read, write: if isOwner(userId); }
      match /recommendations/{id} { allow read, write: if isOwner(userId); }
      match /labResults/{id} { allow read, write: if isOwner(userId); }
      match /reviews/{id} { 
        allow read: if true; 
        allow create: if true; 
      }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read: if true; 
      allow create: if true;
      allow update, delete: if isOwner(resource.data.authorId) || isOwner('public-user');
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      allow read, write: if true; // В прототипе разрешаем доступ для упрощения тестирования чатов
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}