
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ 5.0
     * Обеспечиваем гарантированный доступ для всех авторизованных пользователей.
     */

    // --- Профили пользователей ---
    match /users/{userId} {
      // Любой авторизованный может смотреть профили (для ленты и отзывов)
      allow read: if request.auth != null;
      // Писать в свой профиль может только владелец
      allow update: if request.auth != null && (request.auth.uid == userId || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'rating']));
      allow create: if request.auth != null && request.auth.uid == userId;

      match /dailyLogs/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /dietaryLogs/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /recommendations/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      match /labResults/{id} { allow read, write: if request.auth != null && request.auth.uid == userId; }
      
      // Отзывы доступны всем для чтения, авторизованным - для создания
      match /reviews/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      allow read, create, list: if request.auth != null;
      allow update: if request.auth != null;

      match /messages/{messageId} {
        allow read, list, create: if request.auth != null;
        allow update, delete: if request.auth != null && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
