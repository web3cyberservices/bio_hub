
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - SECURITY RULES (OPEN ACCESS FOR ALL AUTH USERS)
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Правила для пользователей ---

    match /users/{userId} {
      // Разрешаем всем вошедшим видеть базовые профили (для чатов и ленты)
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      match /dailyLogs/{dailyLogId} {
        allow read, write: if isOwner(userId);
      }

      match /dietaryLogs/{dietaryLogId} {
        allow read, write: if isOwner(userId);
      }

      match /recommendations/{recommendationId} {
        allow read, write: if isOwner(userId);
      }
      
      match /labResults/{labId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Посты в ленте - писать могут все авторизованные (даже анонимы)
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); 
      allow update: if isSignedIn(); 
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid);
    }

    // Система чатов
    match /chats/{chatId} {
      // Разрешаем чтение только участникам
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants);
      
      // Создавать чат может любой вошедший
      allow create: if isSignedIn();
      
      // Обновлять (lastMessage и т.д.) могут участники
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        // Доступ к сообщениям через проверку в родительском документе
        allow read, create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
      }
    }
  }
}
