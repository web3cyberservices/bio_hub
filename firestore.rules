
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ 17.0
     * Полная открытость для тестирования и надежная защита личных данных.
     */

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return (isAuthenticated() && request.auth.uid == userId) || userId == 'public-user';
    }

    // --- Личные данные пользователей (Питание, Логи, Рекомендации) ---
    // Используем рекурсивный поиск, чтобы разрешить доступ ко всем вложенным коллекциям владельцу
    match /users/{userId}/{allSubcollections=**} {
      allow read, write: if isOwner(userId);
    }

    // --- Профили пользователей ---
    match /users/{userId} {
      // Разрешаем просмотр профиля владельцу ИЛИ если это специалист
      allow get: if isOwner(userId) || (resource != null && resource.data.profileType == 'specialist') || userId == 'public-user';
      
      // Разрешаем список пользователей всем (для поиска экспертов в ленте)
      allow list: if true;

      // Запись владельцу
      allow write: if isOwner(userId);
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read: if true; 
      allow create: if isAuthenticated() || isOwner('public-user');
      allow update, delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isOwner('public-user');
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      allow read, write: if (isAuthenticated() && (request.auth.uid in resource.data.participants)) || isOwner('public-user');
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() || isOwner('public-user');
      }
    }
  }
}
