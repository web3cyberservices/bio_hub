
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PRO СЕБЯ - ПРАВИЛА БЕЗОПАСНОСТИ 12.0
     * Полная свобода для тестового режима и "Своего плана".
     */

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return (isAuthenticated() && request.auth.uid == userId) || userId == 'public-user';
    }

    // --- Профили пользователей ---
    match /users/{userId} {
      // Разрешаем просмотр если владелец ИЛИ если это специалист
      allow get: if isOwner(userId) || resource.data.profileType == 'specialist';
      
      // Разрешаем список всем (для поиска экспертов)
      allow list: if true;

      // Запись владельцу или в публичный профиль
      allow write: if isOwner(userId);

      // Глубокий доступ ко всем вложенным данным (планы, логи, анализы)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- Bio-Лента (Посты) ---
    match /posts/{postId} {
      allow read: if true; 
      allow create: if isAuthenticated() || isOwner('public-user');
      allow update, delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isOwner('public-user');
    }

    // --- Система чатов ---
    match /chats/{chatId} {
      allow read, update: if (isAuthenticated() && request.auth.uid in resource.data.participants) || isOwner('public-user');
      allow create: if isAuthenticated() || isOwner('public-user');

      match /messages/{messageId} {
        allow read: if isAuthenticated() || isOwner('public-user');
        allow create: if isAuthenticated() || isOwner('public-user');
        allow update, delete: if (isAuthenticated() && resource.data.senderId == request.auth.uid) || isOwner('public-user');
      }
    }
  }
}
