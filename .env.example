# Firebase Configuration (Get this from Firebase Console > Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Security
JWT_SECRET=any_long_random_string_min_32_chars

# Marzban Integration (Optional, for local server)
MARZBAN_API_URL=http://localhost:8000
MARZBAN_ADMIN_TOKEN=your_marzban_admin_token